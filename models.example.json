{
  "providers": {
    "custom": {
      "baseUrl": "https://provider.example.invalid/api",
      "api": "openai-completions",
      "apiKey": "$PI_TEAM_API_KEY",
      "authHeader": true,
      "models": [
        {
          "id": "default-coding",
          "name": "default-coding",
          "reasoning": true,
          "input": [
            "text",
            "image"
